# 摇骰组局 · 服务端环境变量示例
# 用法：cp .env.example .env

PORT=8090
HOST=0.0.0.0

# SQLite 独立数据库文件（相对启动目录或绝对路径均可）
# 部署示例：DATABASE_URL=file:/opt/yaotou/server/data/yaotou.db
DATABASE_URL=file:./data/yaotou.db

# 前端 H5 构建产物目录
PUBLIC_DIR=./public

# 会话签名密钥（生产必须固定！更换后所有人需重新登录）
# 生成：openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
TOKEN_SECRET=
TOKEN_TTL_HOURS=72

# 开发模式登录 dev:<名字>（联调用，上线请设 0）
ALLOW_DEV_LOGIN=1

# 微信小程序（code2session）
WX_APPID=
WX_APPSECRET=

# 抖音小程序（code2session）
TT_APPID=
TT_APPSECRET=
